<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WayGoApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Google Maps SDK for Android API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links & Email Link Sign-In for Firebase Hosting & Custom Domains -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gambiawaygo.com"
                    android:pathPrefix="/__/auth/links" />
                <data
                    android:scheme="https"
                    android:host="banjulway.firebaseapp.com"
                    android:pathPrefix="/__/auth/links" />
                <data
                    android:scheme="https"
                    android:host="banjulway.web.app"
                    android:pathPrefix="/__/auth/links" />
            </intent-filter>

            <!-- General App Links for Gambia WayGo & BanjulWay domains -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gambiawaygo.com" />
                <data
                    android:scheme="https"
                    android:host="banjulway.firebaseapp.com" />
                <data
                    android:scheme="https"
                    android:host="banjulway.web.app" />
                <data
                    android:scheme="https"
                    android:host="waygo.gm" />
            </intent-filter>

            <!-- Custom Scheme Deep Links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="waygo"
                    android:host="finishSignUp" />
                <data
                    android:scheme="waygo"
                    android:host="auth" />
                <data
                    android:scheme="waygo"
                    android:host="verifyEmail" />
            </intent-filter>
        </activity>
    </application>

</manifest>
